{
  "name": "juma-web",
  "account_id": "6f7477f1ef18b1f3b1f8785d2ec7fe57",
  "compatibility_date": "2026-09-09",
  "main": "cloudflare/worker.js",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-cloudflare",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "juma-migration-db",
    "database_id": "c4229704-edcd-4731-913f-1cf028497c3e"
  }],
  "r2_buckets": [{
    "binding": "MEDIA",
    "bucket_name": "juma-media"
  }]
}
