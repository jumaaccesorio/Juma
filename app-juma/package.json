{
  "name": "app-juma",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --port 3000",
    "dev": "vite --port 3000",
    "build": "tsc -b && vite build",
    "build:cloudflare": "node scripts/check-cloudflare-env.mjs && tsc -b && vite build --outDir dist-cloudflare",
    "cf:check": "npm run build:cloudflare && node scripts/deploy-cloudflare.mjs --dry-run",
    "cf:deploy": "npm run build:cloudflare && node scripts/deploy-cloudflare.mjs",
    "cf:preview": "npx --yes wrangler@4.129.0 dev --config wrangler.jsonc",
    "migration:prepare": "node scripts/migration/prepare.mjs",
    "test:migration": "node --test scripts/migration/*.test.mjs cloudflare/*.test.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "optimize:images": "node ./scripts/optimize-storage-images.mjs",
    "export:product-images": "node ./scripts/export-product-images.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.8",
    "sharp": "^0.34.4",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
